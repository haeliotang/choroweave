{
  "name": "choroweave",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "Open infrastructure for executable, hyperlinked 3D worlds (P0 scaffold)",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "pnpm --filter @choroweave/playground dev",
    "build": "pnpm -r build",
    "worlds:build": "node scripts/build-p0-worlds.mjs",
    "validate": "node scripts/validate.mjs --strict",
    "test:p0": "pnpm run worlds:build && pnpm --filter @choroweave/check test",
    "test:e2e": "node scripts/e2e-p0.mjs",
    "tls:fixture": "node scripts/tls-fixture.mjs",
    "test:live": "node scripts/live-conformance.mjs",
    "serve:node": "node scripts/serve-node.mjs",
    "test:hardening": "node scripts/node-hardening.mjs",
    "report:p0": "node scripts/p0-report.mjs",
    "p0:up": "node scripts/p0-up.mjs",
    "repro:check": "node scripts/repro-check.mjs",
    "perf:p0": "node scripts/perf-p0.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "test:source": "node scripts/source-check.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "@choroweave/check": "workspace:*"
  }
}
